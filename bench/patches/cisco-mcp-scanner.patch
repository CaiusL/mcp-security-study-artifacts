@@ -1398,6 +1398,25 @@ async def test_negotiate_mcp_session_initialize_only_when_no_discover(config):
     session.initialize.assert_awaited_once()
 
 
+@pytest.mark.asyncio
+async def test_negotiate_retries_discover_timeout_only_over_stdio(config):
+    scanner = Scanner(config)
+    discover_result = SimpleNamespace(protocol_version="2026-07-28")
+    timeout = _mcp_error(-32001, "Request 'server/discover' timed out")
+
+    session = AsyncMock()
+    session.discover = AsyncMock(side_effect=[timeout, discover_result])
+    result = await scanner._negotiate_mcp_session(session, legacy_stdio=True)
+    assert result is discover_result
+    assert session.discover.await_count == 2
+
+    session = AsyncMock()
+    session.discover = AsyncMock(side_effect=timeout)
+    with pytest.raises(McpError):
+        await scanner._negotiate_mcp_session(session, legacy_http=True)
+    session.initialize.assert_not_called()
+
+
 def test_should_fallback_to_initialize_covers_legacy_shapes(config):
     scanner = Scanner(config)
     assert scanner._should_fallback_to_initialize(_mcp_error(-32601, "Method not found"))
