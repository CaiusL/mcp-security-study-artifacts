    },
    {
      "level": 4,
      "name": "L4 needed shape",
      "rule": "Writes must use a suffix benign tasks wrote. Fetch URLs must match a benign URL."
    },
    {
      "level": 5,
      "name": "L5 needed exact",
      "rule": "The filesystem tool and normalized path must match a benign call."
    }
